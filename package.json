{
  "name": "docket",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Windows CLI and headless library over per-repo Markdown work items.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "docket": "src/cli/main.mjs",
    "dk": "src/cli/main.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./errors": "./src/library/errors.mjs",
    "./schema": "./src/library/schema.mjs",
    "./date": "./src/library/date.mjs",
    "./items/index": "./src/library/items/index.mjs",
    "./items/query": "./src/library/items/query.mjs",
    "./items/detail": "./src/library/items/detail.mjs",
    "./items/relations": "./src/library/items/relations.mjs",
    "./items/set": "./src/library/items/set.mjs",
    "./items/body": "./src/library/items/body.mjs",
    "./items/notes": "./src/library/items/notes.mjs",
    "./items/link": "./src/library/items/link.mjs",
    "./claims": "./src/library/claims.mjs",
    "./repository/context": "./src/library/repository/context.mjs",
    "./repository/canonical": "./src/library/repository/canonical.mjs",
    "./repository/containment": "./src/library/repository/containment.mjs",
    "./repository/registered-checkout": "./src/library/repository/registered-checkout.mjs",
    "./registry/paths": "./src/library/registry/paths.mjs",
    "./registry/source": "./src/library/registry/source.mjs"
  },
  "files": [
    "src/cli/",
    "src/core/",
    "src/storage/",
    "src/repository/",
    "src/state/",
    "src/library/",
    "src/integration/",
    "docs/MOVE-IN.md",
    "docs/AGENT-GUIDE.md",
    "docs/LIBRARY.md",
    "README.md"
  ],
  "scripts": {
    "test": "npm run test:bootstrap && npm run test:format && npm run test:core && npm run test:storage && npm run test:repository && npm run test:cli && npm run test:coordination && npm run test:registry && npm run test:integration && npm run test:packaging && npm run test:scripts && npm run test:layout",
    "test:bootstrap": "node src/bootstrap/check.mjs --repo .",
    "test:format": "node --test \"tests/unit/format/*.test.mjs\"",
    "test:core": "node --test \"tests/unit/core/*.test.mjs\"",
    "test:storage": "node --test \"tests/unit/storage/*.test.mjs\"",
    "test:repository": "node --test \"tests/unit/repository/*.test.mjs\"",
    "test:cli": "node --test \"tests/unit/cli/*.test.mjs\"",
    "test:coordination": "node --test \"tests/unit/state/*.test.mjs\"",
    "test:registry": "node --test \"tests/unit/state/registry/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:packaging": "node --test \"tests/packaging/*.test.mjs\"",
    "test:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/release-scripts.test.ps1",
    "test:layout": "node src/tooling/layout-check.mjs",
    "build": "node src/tooling/build.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9"
  }
}
